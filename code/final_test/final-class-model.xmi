  <packagedElement xmi:type="uml:Class" name="EnrollmentServiceModel">
    <ownedAttribute name="repository" />
    <ownedAttribute name="scorePolicy" />
    <ownedOperation name="enroll" />
    <ownedOperation name="reviewPerformance" />
  </packagedElement>
  <packagedElement xmi:type="uml:Class" name="FinanceServiceModel">
    <ownedAttribute name="notificationGateway" />
